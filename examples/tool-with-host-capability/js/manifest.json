{
  "name": "tool-with-host-capability",
  "version": "0.1.0",
  "pluginApiVersionRequirement": ">=1.0.0",
  "author": "LLMProf",
  "description": {
    "en": "Demonstrates a tool capability calling host capabilities (request_system_model, add_message_activity) and rendering an applet.",
    "de": "Demonstriert eine Tool-Capability, die Host-Capabilities aufruft (request_system_model, add_message_activity) und ein Applet rendert."
  },
  "capabilities": [
    {
      "id": "summarize",
      "type": "tool",
      "execute": "summarize",
      "execution_timeout_ms": 10000
    }
  ],
  "host_capabilities": [
    {
      "id": "add_message_activity",
      "execution_timeout_ms": 5000
    },
    {
      "id": "request_system_model",
      "execution_timeout_ms": 10000
    },
    {
      "id": "log",
      "execution_timeout_ms": 3000
    }
  ],
  "configuration_schema": {},
  "allowed_hosts": [],
  "display_name": {
    "en": "Tool with Host Capability Example",
    "de": "Tool-mit-Host-Capability-Beispiel"
  }
}
